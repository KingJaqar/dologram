# Supabase API URL; hosted projects require HTTPS.
SUPABASE_URL=
# Project reference matching the API URL and database connection.
SUPABASE_PROJECT_REF=
# Server-only secret key for Auth Admin and Storage operations.
SUPABASE_SECRET_KEY=
# Server-only PostgreSQL connection URL for the same project.
SUPABASE_DB_URL=
# Server-only Supabase Management API access token.
SUPABASE_ACCESS_TOKEN=
# Absolute directory for protected database exports and media copies.
BACKUP_DIR=
