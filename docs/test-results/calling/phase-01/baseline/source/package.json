{
  "name": "dologram",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "gen:types": "supabase gen types typescript --project-id dologram --ref none",
    "scan:mobile-bundle": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/scan-mobile-bundle.ps1"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native-reanimated": "4.5.1",
    "react-native-worklets": "0.10.1",
    "expo-asset": "57.0.21",
    "expo-constants": "57.0.23"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.86.3"
  }
}
